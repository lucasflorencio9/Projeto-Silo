// ==================================================
// CONTROLE DA COMPORTA
// ==================================================

void handleAbrirComporta() {
  servoComporta.write(ANGULO_ABERTO);
  comportaAberta = true;

  server.send(200, "application/json",
    "{\"aberta\":true,\"mensagem\":\"Comando de abertura enviado.\"}");
}

void handleFecharComporta() {
  servoComporta.write(ANGULO_FECHADO);
  comportaAberta = false;

  server.send(200, "application/json",
    "{\"aberta\":false,\"mensagem\":\"Comando de fechamento enviado.\"}");
}

void handleEstadoComporta() {
  String json = "{\"aberta\":";
  json += comportaAberta ? "true" : "false";
  json += "}";

  server.send(200, "application/json", json);
}

// ==================================================
// API DE DADOS ATUAIS
// ==================================================

void handleDados() {
  String json = "{";

  json += "\"nivel\":";
  json += String(nivel, 1);

  json += ",\"temperatura\":";
  json += dhtOK ? String(temperatura, 1) : "null";

  json += ",\"umidade\":";
  json += dhtOK ? String(umidade, 1) : "null";

  json += ",\"distancia\":";
  json += ultrassonicoOK ? String(distancia, 2) : "null";

  json += ",\"status\":\"";
  json += obterStatus();
  json += "\"";

  json += ",\"sensorUltrassonico\":";
  json += ultrassonicoOK ? "true" : "false";

  json += ",\"sensorDHT\":";
  json += dhtOK ? "true" : "false";

  json += ",\"comportaAberta\":";
  json += comportaAberta ? "true" : "false";

  json += ",\"uptime\":\"";
  json += obterUptime();
  json += "\"}";

  server.send(200, "application/json", json);
}

// ==================================================
// API DO HISTORICO
// ==================================================

void handleHistorico() {
  String json;
  json.reserve(18000);
  json = "[";

  int inicio = (indiceHistorico - totalRegistros + MAX_REGISTROS)
               % MAX_REGISTROS;

  for (int i = 0; i < totalRegistros; i++) {
    int pos = (inicio + i) % MAX_REGISTROS;
    RegistroHistorico &r = historico[pos];

    if (i > 0) json += ",";

    json += "{\"tempo\":";
    json += String(r.tempo);

    json += ",\"nivel\":";
    json += r.nivelOK ? String(r.nivel, 1) : "null";

    json += ",\"temperatura\":";
    json += r.dhtValido ? String(r.temperatura, 1) : "null";

    json += ",\"umidade\":";
    json += r.dhtValido ? String(r.umidade, 1) : "null";

    json += "}";
  }

  json += "]";
  server.send(200, "application/json", json);
}

// ==================================================
// WIFI E MDNS
// ==================================================

void configurarWiFi() {
  WiFi.mode(WIFI_AP);
  WiFi.softAP(SSID_AP, SENHA_AP);

  Serial.println();
  Serial.println("================================");
  Serial.println("    MONITORAMENTO DO SILO");
  Serial.println("================================");
  Serial.print("Rede Wi-Fi: ");
  Serial.println(SSID_AP);
  Serial.print("Senha: ");
  Serial.println(SENHA_AP);
  Serial.print("IP local: ");
  Serial.println(WiFi.softAPIP());

  if (MDNS.begin(HOSTNAME)) {
    MDNS.addService("http", "tcp", 80);
    Serial.println("mDNS iniciado com sucesso.");
    Serial.println("Endereco principal: http://silo.local");
  } else {
    Serial.println("Falha ao iniciar mDNS.");
  }
}

// ==================================================
// CONFIGURAR ROTAS DO SERVIDOR
// ==================================================

void configurarServidor() {
  server.on("/", HTTP_GET, handleRoot);
  server.on("/graficos", HTTP_GET, handleGraficos);
  server.on("/comporta", HTTP_GET, handleComporta);

  server.on("/dados", HTTP_GET, handleDados);
  server.on("/historico", HTTP_GET, handleHistorico);

  server.on("/abrir", HTTP_POST, handleAbrirComporta);
  server.on("/fechar", HTTP_POST, handleFecharComporta);
  server.on("/estadoComporta", HTTP_GET, handleEstadoComporta);

  server.onNotFound([]() {
    server.send(404, "text/plain; charset=utf-8",
                "Pagina nao encontrada. Acesse http://silo.local");
  });

  server.begin();
  Serial.println("Servidor HTTP iniciado.");
}

// ==================================================
// SETUP
// ==================================================

void setup() {
  Serial.begin(115200);

  pinMode(TRIG_PIN, OUTPUT);
  digitalWrite(TRIG_PIN, LOW);
  pinMode(ECHO_PIN, INPUT);

  dht.begin();

  Wire.begin(OLED_SDA, OLED_SCL);

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("Erro ao iniciar OLED!");
    while (true) {
      delay(100);
    }
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(20, 0);
  display.println("MONITORAMENTO");
  display.setCursor(35, 12);
  display.println("DO SILO");
  display.setCursor(0, 30);
  display.println("Wi-Fi:");
  display.println("Silo-ESP32");
  display.setCursor(0, 50);
  display.println("silo.local");
  display.display();

  // Inicializar servo na posicao fechada
  servoComporta.setPeriodHertz(50);
  servoComporta.attach(SERVO_PIN, 500, 2400);
  servoComporta.write(ANGULO_FECHADO);
  comportaAberta = false;

  delay(1000);

  // Iniciar rede, mDNS e servidor
  configurarWiFi();
  configurarServidor();

  // Primeiras leituras
  atualizarUltrassonico();
  atualizarDHT();
  atualizarOLED();
  registrarHistorico();

  unsigned long agora = millis();
  ultimoUltrassonico = agora;
  ultimoDHT = agora;
  ultimoOLED = agora;

  Serial.println();
  Serial.println("================================");
  Serial.println("       SISTEMA PRONTO");
  Serial.println("================================");
  Serial.println("HOME:      http://silo.local/");
  Serial.println("GRAFICOS:  http://silo.local/graficos");
  Serial.println("COMPORTA:  http://silo.local/comporta");
  Serial.println("================================");
}

// ==================================================
// LOOP PRINCIPAL
// ==================================================

void loop() {
  server.handleClient();

  unsigned long agora = millis();

  if (agora - ultimoUltrassonico >= INTERVALO_ULTRASSONICO) {
    ultimoUltrassonico = agora;
    atualizarUltrassonico();
  }

  if (agora - ultimoDHT >= INTERVALO_DHT) {
    ultimoDHT = agora;
    atualizarDHT();
  }

  if (agora - ultimoOLED >= INTERVALO_OLED) {
    ultimoOLED = agora;
    atualizarOLED();
  }

  registrarHistorico();
}
