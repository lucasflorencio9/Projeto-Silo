const iconeEl=document.getElementById('icone');
const botoes=[document.getElementById('btnAbrir'),document.getElementById('btnFechar')];
function mostrarEstado(aberta){
estadoEl.textContent=aberta?'COMPORTA ABERTA':'COMPORTA FECHADA';
estadoEl.className=aberta?'status open':'status';
iconeEl.textContent=aberta?'▱':'▤';
}
async function consultar(){
try{let r=await fetch('/estadoComporta',{cache:'no-store'});if(!r.ok)throw Error();let d=await r.json();mostrarEstado(d.aberta);}
catch(e){estadoEl.textContent='SEM COMUNICAÇÃO';}
}
async function acionar(url){
botoes.forEach(b=>b.disabled=true);mensagemEl.textContent='Enviando comando...';
try{
let r=await fetch(url,{method:'POST'});let d=await r.json();if(!r.ok)throw Error();
mostrarEstado(d.aberta);mensagemEl.textContent=d.mensagem;
}catch(e){mensagemEl.textContent='Falha de comunicação com a ESP32.';}
finally{botoes.forEach(b=>b.disabled=false);}
}
consultar();
