float distancia = -1;
float nivel = 0;
float temperatura = NAN;
float umidade = NAN;

bool ultrassonicoOK = false;
bool dhtOK = false;
bool comportaAberta = false;

enum StatusSilo {
  STATUS_ERRO,
  STATUS_BAIXO,
  STATUS_NORMAL,
  STATUS_ALTO,
  STATUS_CHEIO
};

StatusSilo statusAtual = STATUS_ERRO;

unsigned long ultimoUltrassonico = 0;
unsigned long ultimoDHT = 0;
unsigned long ultimoOLED = 0;
unsigned long ultimaGravacaoHistorico = 0;

const unsigned long INTERVALO_ULTRASSONICO = 1000;
const unsigned long INTERVALO_DHT = 2000;
const unsigned long INTERVALO_OLED = 1000;
const unsigned long INTERVALO_HISTORICO = 5000;

struct RegistroHistorico {
  unsigned long tempo;
  float nivel;
  float temperatura;
  float umidade;
  bool nivelOK;
  bool dhtValido;
};

const int MAX_REGISTROS = 360;
RegistroHistorico historico[MAX_REGISTROS];

int totalRegistros = 0;
int indiceHistorico = 0;

// ==================================================
// SENSOR ULTRASSONICO
// ==================================================

float medirDistancia() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  long duracao = pulseIn(ECHO_PIN, HIGH, 30000);

  if (duracao == 0) return -1;

  return duracao * 0.0343 / 2.0;
}

float medirDistanciaMedia() {
  float soma = 0;
  int validas = 0;

  for (int i = 0; i < 5; i++) {
    float leitura = medirDistancia();

    if (leitura > 0 && leitura < 400) {
      soma += leitura;
      validas++;
    }

    delay(20);
  }

  if (validas == 0) return -1;

  return soma / validas;
}

void calcularNivel() {
  if (!ultrassonicoOK || distancia < 0) return;

  nivel = ((DISTANCIA_VAZIO - distancia) /
          (DISTANCIA_VAZIO - DISTANCIA_CHEIO)) * 100.0;

  nivel = constrain(nivel, 0, 100);
}

void atualizarStatus() {
  if (!ultrassonicoOK) {
    statusAtual = STATUS_ERRO;
    return;
  }

  switch (statusAtual) {
    case STATUS_ERRO:
      if (nivel < 25) statusAtual = STATUS_BAIXO;
      else if (nivel < 75) statusAtual = STATUS_NORMAL;
      else if (nivel < 90) statusAtual = STATUS_ALTO;
      else statusAtual = STATUS_CHEIO;
      break;

    case STATUS_BAIXO:
      if (nivel >= 27) {
        if (nivel < 75) statusAtual = STATUS_NORMAL;
        else if (nivel < 90) statusAtual = STATUS_ALTO;
        else statusAtual = STATUS_CHEIO;
      }
      break;

    case STATUS_NORMAL:
      if (nivel < 23) statusAtual = STATUS_BAIXO;
      else if (nivel >= 77) {
        if (nivel < 90) statusAtual = STATUS_ALTO;
        else statusAtual = STATUS_CHEIO;
      }
      break;

    case STATUS_ALTO:
      if (nivel < 73) {
        if (nivel < 23) statusAtual = STATUS_BAIXO;
        else statusAtual = STATUS_NORMAL;
      } else if (nivel >= 92) {
        statusAtual = STATUS_CHEIO;
      }
      break;

    case STATUS_CHEIO:
      if (nivel < 88) {
        if (nivel < 73) {
          if (nivel < 23) statusAtual = STATUS_BAIXO;
          else statusAtual = STATUS_NORMAL;
        } else {
          statusAtual = STATUS_ALTO;
        }
      }
      break;
  }
}

String obterStatus() {
  switch (statusAtual) {
    case STATUS_BAIXO: return "BAIXO";
    case STATUS_NORMAL: return "NORMAL";
    case STATUS_ALTO: return "ALTO";
    case STATUS_CHEIO: return "CHEIO";
    default: return "ERRO SENSOR";
  }
}

void atualizarUltrassonico() {
  float novaDistancia = medirDistanciaMedia();

  if (novaDistancia > 0) {
    distancia = novaDistancia;
    ultrassonicoOK = true;
    calcularNivel();
    atualizarStatus();
  } else {
    ultrassonicoOK = false;
    statusAtual = STATUS_ERRO;
  }
}

// ==================================================
// SENSOR DHT11
// ==================================================

void atualizarDHT() {
  float t = dht.readTemperature();
  float u = dht.readHumidity();

  if (!isnan(t) && !isnan(u)) {
    temperatura = t;
    umidade = u;
    dhtOK = true;
  } else {
    dhtOK = false;
  }
}

// ==================================================
// TEMPO DE FUNCIONAMENTO
// ==================================================

String obterUptime() {
  unsigned long s = millis() / 1000UL;
  unsigned long dias = s / 86400UL;
  s %= 86400UL;

  unsigned long horas = s / 3600UL;
  s %= 3600UL;

  unsigned long minutos = s / 60UL;
  s %= 60UL;

  char buffer[40];

  snprintf(buffer, sizeof(buffer),
    "%lu d %02lu:%02lu:%02lu",
    dias, horas, minutos, s);

  return String(buffer);
}

// ==================================================
// HISTORICO DOS GRAFICOS
// ==================================================

void registrarHistorico() {
  unsigned long agora = millis();

  if (totalRegistros > 0 &&
      agora - ultimaGravacaoHistorico < INTERVALO_HISTORICO) {
    return;
  }

  ultimaGravacaoHistorico = agora;

  RegistroHistorico &r = historico[indiceHistorico];

  r.tempo = agora / 1000UL;
  r.nivel = nivel;
  r.temperatura = temperatura;
  r.umidade = umidade;
  r.nivelOK = ultrassonicoOK;
  r.dhtValido = dhtOK;

  indiceHistorico = (indiceHistorico + 1) % MAX_REGISTROS;

  if (totalRegistros < MAX_REGISTROS) {
    totalRegistros++;
  }
}

// ==================================================
// OLED
// ==================================================

void atualizarOLED() {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);
  display.setCursor(20, 0);
  display.println("MONITORAMENTO SILO");
  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  display.setCursor(0, 15);
  display.println("NIVEL");

  display.setTextSize(2);
  display.setCursor(0, 26);

  if (ultrassonicoOK) {
    display.print((int)nivel);
    display.println("%");
  } else {
    display.println("ERRO");
  }

  display.setTextSize(1);
  display.setCursor(55, 17);
  display.println(obterStatus());

  display.drawRect(55, 30, 42, 11, SSD1306_WHITE);

  if (ultrassonicoOK) {
    int largura = (int)(nivel * 38.0 / 100.0);
    largura = constrain(largura, 0, 38);

    if (largura > 0) {
      display.fillRect(57, 32, largura, 7, SSD1306_WHITE);
    }
  }

  display.drawLine(0, 45, 127, 45, SSD1306_WHITE);

  display.setCursor(0, 51);
  display.print("T:");

  if (dhtOK) {
    display.print(temperatura, 0);
    display.print("C");
  } else {
    display.print("ERR");
  }

  display.setCursor(55, 51);
  display.print("U:");

  if (dhtOK) {
    display.print(umidade, 0);
    display.print("%");
  } else {
    display.print("ERR");
  }

  display.display();
}

