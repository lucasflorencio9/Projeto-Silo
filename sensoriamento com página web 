#include <Adafruit_SSD1306.h>
#include <DHT.h>
#include <WiFi.h>
#include <WebServer.h>

// =====================================================
// PINOS
// =====================================================

#define TRIG_PIN 5
#define ECHO_PIN 18

#define DHT_PIN 15
#define DHT_TYPE DHT11

#define OLED_SDA 21
#define OLED_SCL 22


// =====================================================
// CALIBRAÇÃO DO SILO
// =====================================================

// Distância média medida com o silo vazio
#define DISTANCIA_VAZIO 20.15

// Distância provisória para considerar o silo cheio
#define DISTANCIA_CHEIO 2.0


// =====================================================
// REDE WI-FI DO ESP32
// =====================================================

const char* SSID_AP = "Silo-ESP32";
const char* SENHA_AP = "12345678";


// =====================================================
// SERVIDOR WEB
// =====================================================

WebServer server(80);


// =====================================================
// OLED
// =====================================================

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  -1
);


// =====================================================
// DHT11
// =====================================================

DHT dht(DHT_PIN, DHT_TYPE);


// =====================================================
// VARIÁVEIS DOS SENSORES
// =====================================================

float distancia = -1;
float nivel = 0;
float temperatura = NAN;
float umidade = NAN;


// =====================================================
// CONTROLE DE TEMPO
// =====================================================

unsigned long ultimoCiclo = 0;

const unsigned long INTERVALO_LEITURA = 2000;


// =====================================================
// MEDIÇÃO DO SENSOR ULTRASSÔNICO
// =====================================================

float medirDistancia() {

  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  long duracao = pulseIn(ECHO_PIN, HIGH, 30000);

  if (duracao == 0) {
    return -1;
  }

  float distanciaMedida = duracao * 0.0343 / 2;

  return distanciaMedida;
}


// =====================================================
// MÉDIA DAS LEITURAS
// =====================================================

float medirDistanciaMedia() {

  float soma = 0;

  int leiturasValidas = 0;

  // Faz 5 leituras
  for (int i = 0; i < 5; i++) {

    float leitura = medirDistancia();

    if (leitura > 0) {

      soma += leitura;

      leiturasValidas++;
    }

    delay(50);
  }

  if (leiturasValidas == 0) {

    return -1;
  }

  return soma / leiturasValidas;
}


// =====================================================
// CALCULA O NÍVEL
// =====================================================

void calcularNivel() {

  if (distancia < 0) {

    nivel = 0;

    return;
  }

  nivel =
    ((DISTANCIA_VAZIO - distancia) /
    (DISTANCIA_VAZIO - DISTANCIA_CHEIO)) * 100;


  // Limita entre 0 e 100%
  if (nivel < 0) {
    nivel = 0;
  }

  if (nivel > 100) {
    nivel = 100;
  }
}


// =====================================================
// RETORNA STATUS DO SILO
// =====================================================

String obterStatus() {

  if (distancia < 0) {

    return "ERRO";
  }

  if (nivel < 25) {

    return "VAZIO";
  }

  if (nivel < 75) {

    return "NORMAL";
  }

  return "CHEIO";
}


// =====================================================
// ATUALIZA OLED
// =====================================================

void atualizarOLED() {

  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);


  // ===================================================
  // 1. TÍTULO
  // ===================================================

  display.setTextSize(1);

  display.setCursor(0, 0);

  display.println("MONITORAMENTO SILO");

  display.drawLine(
    0, 10,
    127, 10,
    SSD1306_WHITE
  );


  // ===================================================
  // 2. NÍVEL
  // ===================================================

  display.setCursor(0, 16);

  display.setTextSize(1);

  display.println("Nivel:");


  display.setTextSize(2);

  display.setCursor(0, 27);

  if (distancia < 0) {

    display.println("ERRO");

  } else {

    display.print((int)nivel);

    display.println("%");
  }


  // ===================================================
  // 3. STATUS
  // ===================================================

  display.setTextSize(1);

  display.setCursor(45, 18);

  display.print(obterStatus());


  // ===================================================
  // 4. BARRA VERTICAL
  // ===================================================

  display.drawRect(
    102, 18,
    22, 42,
    SSD1306_WHITE
  );


  int alturaBarra =
    (int)(nivel * 38.0 / 100.0);


  if (alturaBarra < 0) {
    alturaBarra = 0;
  }

  if (alturaBarra > 38) {
    alturaBarra = 38;
  }


  if (alturaBarra > 0) {

    display.fillRect(
      104,
      58 - alturaBarra,
      18,
      alturaBarra,
      SSD1306_WHITE
    );
  }


  // ===================================================
  // 5. LINHA DIVISÓRIA
  // ===================================================

  display.drawLine(
    0, 48,
    96, 48,
    SSD1306_WHITE
  );


  // ===================================================
  // 6. TEMPERATURA
  // ===================================================

  display.setTextSize(1);

  display.setCursor(0, 52);

  display.print("T:");

  if (isnan(temperatura)) {

    display.print("--");

  } else {

    display.print(temperatura, 0);
  }

  display.print("C");


  // ===================================================
  // 7. UMIDADE
  // ===================================================

  display.setCursor(50, 52);

  display.print("U:");

  if (isnan(umidade)) {

    display.print("--");

  } else {

    display.print(umidade, 0);
  }

  display.print("%");


  display.display();
}


