// =====================================================
// ENVIA DADOS PARA A PÁGINA
// =====================================================

void handleDados() {

  String json = "{";

  json += "\"nivel\":";
  json += String(nivel, 1);

  json += ",";

  json += "\"temperatura\":";

  if (isnan(temperatura)) {
    json += "null";
  } else {
    json += String(temperatura, 1);
  }

  json += ",";

  json += "\"umidade\":";

  if (isnan(umidade)) {
    json += "null";
  } else {
    json += String(umidade, 1);
  }

  json += ",";

  json += "\"distancia\":";

  if (distancia < 0) {
    json += "null";
  } else {
    json += String(distancia, 2);
  }

  json += ",";

  json += "\"status\":\"";
  json += obterStatus();
  json += "\"";

  json += "}";


  server.send(
    200,
    "application/json",
    json
  );
}


// =====================================================
// CONFIGURAÇÃO DA REDE
// =====================================================

void configurarWiFi() {

  WiFi.mode(WIFI_AP);

  WiFi.softAP(
    SSID_AP,
    SENHA_AP
  );


  Serial.println();
  Serial.println("==============================");

  Serial.println("REDE WI-FI DO SILO");

  Serial.print("Nome: ");
  Serial.println(SSID_AP);

  Serial.print("Senha: ");
  Serial.println(SENHA_AP);

  Serial.print("Endereco: ");
  Serial.println(WiFi.softAPIP());

  Serial.println("==============================");
}


// =====================================================
// CONFIGURAÇÃO DO SERVIDOR
// =====================================================

void configurarServidor() {

  server.on(
    "/",
    handleRoot
  );


  server.on(
    "/dados",
    handleDados
  );


  server.begin();


  Serial.println(
    "Servidor web iniciado!"
  );
}


// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);


  // -------------------------
  // Ultrassônico
  // -------------------------

  pinMode(TRIG_PIN, OUTPUT);

  pinMode(ECHO_PIN, INPUT);


  // -------------------------
  // DHT11
  // -------------------------

  dht.begin();


  // -------------------------
  // OLED
  // -------------------------

  Wire.begin(
    OLED_SDA,
    OLED_SCL
  );


  if (!display.begin(
        SSD1306_SWITCHCAPVCC,
        0x3C
      )) {

    Serial.println(
      "Erro ao iniciar OLED!"
    );

    while (true);
  }


  // -------------------------
  // Tela inicial
  // -------------------------

  display.clearDisplay();

  display.setTextColor(
    SSD1306_WHITE
  );

  display.setTextSize(1);

  display.setCursor(0, 0);

  display.println(
    "MONITORAMENTO"
  );

  display.println(
    "DO SILO"
  );

  display.display();

  delay(2000);


  // -------------------------
  // Wi-Fi
  // -------------------------

  configurarWiFi();


  // -------------------------
  // Servidor
  // -------------------------

  configurarServidor();
}


// =====================================================
// LOOP
// =====================================================

void loop() {

  // Mantém o servidor funcionando
  server.handleClient();


  // Verifica se já passou o intervalo
  if (
    millis() - ultimoCiclo >=
    INTERVALO_LEITURA
  ) {

    ultimoCiclo = millis();


    // -------------------------
    // Leitura dos sensores
    // -------------------------

    distancia =
      medirDistanciaMedia();


    temperatura =
      dht.readTemperature();


    umidade =
      dht.readHumidity();


    // -------------------------
    // Calcula nível
    // -------------------------

    calcularNivel();


    // -------------------------
    // Serial
    // -------------------------

    Serial.println();

    Serial.println(
      "------------------------------"
    );


    Serial.print(
      "Distancia: "
    );

    if (distancia < 0) {

      Serial.println("ERRO");

    } else {

      Serial.print(
        distancia,
        2
      );

      Serial.println(
        " cm"
      );
    }


    Serial.print(
      "Nivel: "
    );

    Serial.print(
      nivel,
      1
    );

    Serial.println(
      "%"
    );


    Serial.print(
      "Status: "
    );

    Serial.println(
      obterStatus()
    );


    Serial.print(
      "Temperatura: "
    );

    if (isnan(temperatura)) {

      Serial.println(
        "ERRO"
      );

    } else {

      Serial.print(
        temperatura,
        1
      );

      Serial.println(
        " C"
      );
    }


    Serial.print(
      "Umidade: "
    );

    if (isnan(umidade)) {

      Serial.println(
        "ERRO"
      );

    } else {

      Serial.print(
        umidade,
        1
      );

      Serial.println(
        " %"
      );
    }


    // -------------------------
    // Atualiza OLED
    // -------------------------

    atualizarOLED();
  }
}