<script>
let periodoSegundos=300;
let dadosHistorico=[];
const cores={nivel:'#f59e0b',temperatura:'#fb7185',umidade:'#38bdf8'};
document.querySelectorAll('[data-period]').forEach(botao=>{
  botao.addEventListener('click',()=>{
    document.querySelectorAll('[data-period]').forEach(b=>b.classList.remove('active'));
    botao.classList.add('active');
    periodoSegundos=Number(botao.dataset.period);
    desenharTodos();
  });
});
function prepararCanvas(canvas){
  const rect=canvas.getBoundingClientRect();
  const ratio=window.devicePixelRatio||1;
  canvas.width=Math.max(1,Math.round(rect.width*ratio));
  canvas.height=Math.max(1,Math.round(rect.height*ratio));
  const ctx=canvas.getContext('2d');
  ctx.setTransform(ratio,0,0,ratio,0,0);
  return {ctx,w:rect.width,h:rect.height};
}
function desenharGrafico(id,chave,cor,unidade,minFixo,maxFixo){
  const canvas=document.getElementById(id);
  const {ctx,w,h}=prepararCanvas(canvas);
  ctx.clearRect(0,0,w,h);
  const margem={esq:42,dir:12,top:14,baixo:28};
  const plotW=w-margem.esq-margem.dir;
  const plotH=h-margem.top-margem.baixo;
  const janela=periodoSegundos;
  const agora=dadosHistorico.length?dadosHistorico[dadosHistorico.length-1].tempo:0;
  const filtrados=dadosHistorico.filter(d=>d.tempo>=agora-janela && d[chave]!==null && Number.isFinite(d[chave]));
  let ymin=minFixo, ymax=maxFixo;
  if(ymin===null||ymax===null){
    if(filtrados.length){
      const valores=filtrados.map(d=>d[chave]);
      const lo=Math.min(...valores), hi=Math.max(...valores);
      const folga=Math.max((hi-lo)*0.2,1);
      ymin=Math.floor(lo-folga);ymax=Math.ceil(hi+folga);
      if(ymin===ymax){ymin-=1;ymax+=1;}
    }else{ymin=0;ymax=10;}
  }
  ctx.font='11px Arial';
  ctx.lineWidth=1;
  ctx.strokeStyle='#263244';
  ctx.fillStyle='#94a3b8';
  for(let i=0;i<=4;i++){
    const y=margem.top+plotH*i/4;
    const valor=ymax-(ymax-ymin)*i/4;
    ctx.beginPath();ctx.moveTo(margem.esq,y);ctx.lineTo(w-margem.dir,y);ctx.stroke();
    ctx.textAlign='right';ctx.textBaseline='middle';
    ctx.fillText(valor.toFixed(unidade==='°C'?1:0),margem.esq-7,y);
  }
  for(let i=0;i<=4;i++){
    const x=margem.esq+plotW*i/4;
    ctx.beginPath();ctx.moveTo(x,margem.top);ctx.lineTo(x,margem.top+plotH);ctx.stroke();
    const segundosAtras=janela*(1-i/4);
    let label;
    if(segundosAtras>=60)label='-'+Math.round(segundosAtras/60)+'m';
    else label='-'+Math.round(segundosAtras)+'s';
    if(i===4)label='agora';
    ctx.textAlign=i===0?'left':(i===4?'right':'center');ctx.textBaseline='top';
    ctx.fillText(label,x,margem.top+plotH+8);
  }
  if(!filtrados.length){
    ctx.fillStyle='#94a3b8';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText('Aguardando dados válidos...',w/2,h/2);
    return;
  }
  ctx.strokeStyle=cor;ctx.lineWidth=2.5;ctx.lineJoin='round';ctx.lineCap='round';
  ctx.beginPath();
  filtrados.forEach((d,i)=>{
    const x=margem.esq+Math.max(0,Math.min(1,(d.tempo-(agora-janela))/janela))*plotW;
    const y=margem.top+(ymax-d[chave])/(ymax-ymin)*plotH;
    if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
  });
  ctx.stroke();
  const ultimo=filtrados[filtrados.length-1];
  const ux=margem.esq+Math.max(0,Math.min(1,(ultimo.tempo-(agora-janela))/janela))*plotW;
  const uy=margem.top+(ymax-ultimo[chave])/(ymax-ymin)*plotH;
  ctx.fillStyle=cor;ctx.beginPath();ctx.arc(ux,uy,4,0,Math.PI*2);ctx.fill();
}
function desenharTodos(){
  desenharGrafico('graficoNivel','nivel',cores.nivel,'%',0,100);
  desenharGrafico('graficoTemperatura','temperatura',cores.temperatura,'°C',null,null);
  desenharGrafico('graficoUmidade','umidade',cores.umidade,'%',0,100);
  const janela=periodoSegundos;
  const agora=dadosHistorico.length?dadosHistorico[dadosHistorico.length-1].tempo:0;
  const visiveis=dadosHistorico.filter(d=>d.tempo>=agora-janela);
  document.getElementById('notaNivel').textContent=
    visiveis.length+' amostras neste período. Histórico disponível: até 30 minutos. Os primeiros pontos aparecem após as primeiras gravações.';
}
async function atualizarHistorico(){
  try{
    const resposta=await fetch('/historico',{cache:'no-store'});
    if(!resposta.ok)throw new Error('HTTP '+resposta.status);
    dadosHistorico=await resposta.json();
    const validosNivel=dadosHistorico.filter(d=>d.nivel!==null);
    const validosTemp=dadosHistorico.filter(d=>d.temperatura!==null);
    const validosUmid=dadosHistorico.filter(d=>d.umidade!==null);
    document.getElementById('nivelAtual').textContent=validosNivel.length?Number(validosNivel[validosNivel.length-1].nivel).toFixed(1):'--';
    document.getElementById('tempAtual').textContent=validosTemp.length?Number(validosTemp[validosTemp.length-1].temperatura).toFixed(1):'--';
    document.getElementById('umidAtual').textContent=validosUmid.length?Number(validosUmid[validosUmid.length-1].umidade).toFixed(1):'--';
    desenharTodos();
  }catch(e){console.log('Erro ao buscar histórico:',e);}
}
window.addEventListener('resize',desenharTodos);
atualizarHistorico();
setInterval(atualizarHistorico,5000);
</script>
