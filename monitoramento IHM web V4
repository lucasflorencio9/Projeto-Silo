// =====================================================
// API DE DADOS ATUAIS
// =====================================================
void handleDados() {
  String json = "{";

  json += "\"nivel\":";
  json += String(nivel, 1);

  json += ",\"temperatura\":";
  json += dhtOK ? String(temperatura, 1) : "null";

  json += ",\"umidade\":";
  json += dhtOK ? String(umidade, 1) : "null";

  json += ",\"distancia\":";
  json += ultrassonicoOK ? String(distancia, 2) : "null";

  json += ",\"status\":\"";
  json += obterStatus();
  json += "\"";

  json += ",\"sensorUltrassonico\":";
  json += ultrassonicoOK ? "true" : "false";

  json += ",\"sensorDHT\":";
  json += dhtOK ? "true" : "false";

  json += ",\"uptime\":\"";
  json += obterUptime();
  json += "\"";

  json += "}";
  server.send(200, "application/json", json);
}

// =====================================================
// API DO HISTORICO
// =====================================================
void handleHistorico() {
  String json;
  json.reserve(18000);
  json = "[";

  int inicio = (indiceHistorico - totalRegistros + MAX_REGISTROS)
               % MAX_REGISTROS;

  for (int i = 0; i < totalRegistros; i++) {
    int pos = (inicio + i) % MAX_REGISTROS;
    RegistroHistorico &r = historico[pos];

    if (i > 0) json += ",";
    json += "{\"tempo\":";
    json += String(r.tempo);

    json += ",\"nivel\":";
    json += r.nivelOK ? String(r.nivel, 1) : "null";

    json += ",\"temperatura\":";
    json += r.dhtValido ? String(r.temperatura, 1) : "null";

    json += ",\"umidade\":";
    json += r.dhtValido ? String(r.umidade, 1) : "null";

    json += "}";
  }

  json += "]";
  server.send(200, "application/json", json);
}

// =====================================================
// WIFI
// =====================================================
void configurarWiFi() {
  WiFi.mode(WIFI_AP);
  WiFi.softAP(SSID_AP, SENHA_AP);

  Serial.println();
  Serial.println("================================");
  Serial.println("      SUPERVISORIO DO SILO");
  Serial.println("================================");
  Serial.print("Wi-Fi: ");
  Serial.println(SSID_AP);
  Serial.print("Senha: ");
  Serial.println(SENHA_AP);
  Serial.print("IP: ");
  Serial.println(WiFi.softAPIP());

  if (MDNS.begin(HOSTNAME)) {
    Serial.println("mDNS: OK");
    Serial.print("Acesso: http://");
    Serial.print(HOSTNAME);
    Serial.println(".local");
  } else {
    Serial.println("mDNS: ERRO");
  }
  Serial.println("================================");
}

// =====================================================
// SERVIDOR
// =====================================================
void configurarServidor() {
  server.on("/", HTTP_GET, handleRoot);
  server.on("/graficos", HTTP_GET, handleGraficos);
  server.on("/dados", HTTP_GET, handleDados);
  server.on("/historico", HTTP_GET, handleHistorico);
  server.begin();
  Serial.println("Servidor HTTP: OK");
}

// =====================================================
// SETUP
// =====================================================
void setup() {
  Serial.begin(115200);

  pinMode(TRIG_PIN, OUTPUT);
  digitalWrite(TRIG_PIN, LOW);
  pinMode(ECHO_PIN, INPUT);

  dht.begin();

  Wire.begin(OLED_SDA, OLED_SCL);
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("Erro ao iniciar OLED!");
    while (true) delay(100);
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(20, 0);
  display.println("MONITORAMENTO");
  display.setCursor(35, 12);
  display.println("DO SILO");
  display.setCursor(0, 30);
  display.println("Wi-Fi:");
  display.println("Silo-ESP32");
  display.setCursor(0, 50);
  display.println("silo.local");
  display.display();

  delay(1500);

  configurarWiFi();
  configurarServidor();

  atualizarUltrassonico();
  atualizarDHT();
  atualizarOLED();
  registrarHistorico();

  Serial.println();
  Serial.println("================================");
  Serial.println(" SISTEMA PRONTO");
  Serial.println("================================");
  Serial.println("Home: http://192.168.4.1/");
  Serial.println("Graficos: http://192.168.4.1/graficos");
  Serial.println("mDNS: http://silo.local");
  Serial.println("================================");
}

// =====================================================
// LOOP
// =====================================================
void loop() {
  server.handleClient();

  unsigned long agora = millis();

  if (agora - ultimoUltrassonico >= INTERVALO_ULTRASSONICO) {
    ultimoUltrassonico = agora;
    atualizarUltrassonico();
  }

  if (agora - ultimoDHT >= INTERVALO_DHT) {
    ultimoDHT = agora;
    atualizarDHT();
  }

  if (agora - ultimoOLED >= INTERVALO_OLED) {
    ultimoOLED = agora;
    atualizarOLED();
  }

  registrarHistorico();
}
