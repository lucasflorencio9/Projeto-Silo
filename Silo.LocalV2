.material{position:absolute;bottom:0;width:100%;height:0%;background:linear-gradient(#f5d05c,#bd851e);transition:height .5s}
.level{text-align:center;font-size:34px;font-weight:bold;color:var(--yellow);font-variant-numeric:tabular-nums}
.status{text-align:center;padding:9px;color:var(--cyan);font-size:12px;font-weight:bold;letter-spacing:1px}
.metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.metric{padding:14px;background:var(--panel2);border:1px solid #3b4852;border-radius:4px;min-width:0}
.label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px}
.value{font-size:24px;font-weight:bold;margin-top:8px;overflow-wrap:anywhere;color:#f1f5f7;font-variant-numeric:tabular-nums}
.rows{font-size:12px;margin-top:16px}
.rows div{padding:11px 2px;border-bottom:1px solid #3a444d}
.ok{color:var(--green)}.err{color:var(--red)}
footer{text-align:center;padding:20px;color:#82909a;font-size:10px;letter-spacing:1px}
.chart{padding:12px}
canvas{display:block;width:100%;height:240px}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
button{background:#303b44;color:#eaf0f3;border:1px solid #52616c;border-radius:4px;padding:10px 15px;cursor:pointer;font-weight:bold;font-size:12px;letter-spacing:.4px}
button.active,button:hover{background:#245c49;border-color:var(--green)}
.note{font-size:11px;color:#9aa7b2;padding:0 4px 12px}
.content{padding:22px}
p{font-size:13px;color:#b1bdc5;line-height:1.6}
.gate{width:120px;height:120px;margin:24px auto;border:3px solid #788994;border-radius:8px;background:#151c22;display:flex;align-items:center;justify-content:center;font-size:48px;color:var(--cyan);box-shadow:inset 0 0 18px #0008}
.status{padding:14px;border:1px solid #3b4852;border-radius:4px;text-align:center;font-weight:bold;background:#26343d;color:var(--cyan);margin:20px 0}
.status.open{background:#40351e;border-color:#9a772b;color:var(--yellow)}
