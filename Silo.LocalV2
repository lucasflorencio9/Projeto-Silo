// ==================================================

void handleRoot() {
  String html = R"rawliteral(
<!DOCTYPE html><html lang="pt-BR"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Silo - Home</title>
<style>
:root{color-scheme:dark;--bg:#171b20;--panel:#222930;--panel2:#1b2229;--line:#3b4650;--muted:#9aa7b2;--text:#edf2f5;--green:#38c879;--yellow:#f2c14e;--red:#ef5350;--cyan:#48c6d8;--blue:#3485b8}
*{box-sizing:border-box}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text);letter-spacing:.15px}
header{background:#20272e;border-bottom:2px solid #3a4852;padding:15px 22px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;box-shadow:0 3px 12px #0005}
header b{font-size:16px;letter-spacing:1.1px;color:#fff}
header div div{color:var(--cyan)!important;font-size:10px!important;letter-spacing:1.3px;margin-top:5px}
nav{display:flex;gap:7px;flex-wrap:wrap}
nav a{color:#c4cdd4;text-decoration:none;padding:10px 14px;border:1px solid #46535e;border-radius:4px;font-size:12px;font-weight:bold;letter-spacing:.5px;background:#29323a}
nav a.active,nav a:hover{background:#245c49;border-color:var(--green);color:#fff}
main{max-width:1120px;margin:auto;padding:20px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:5px;overflow:hidden;box-shadow:0 4px 14px #0003}
.ph{padding:14px 16px;border-bottom:1px solid var(--line);font-size:12px;font-weight:bold;letter-spacing:1px;color:#dce5eb;background:#29323a}
.body{padding:18px}
.silo{width:150px;height:215px;margin:8px auto 16px;border:3px solid #84939e;border-radius:58px 58px 12px 12px;position:relative;overflow:hidden;background:#13191e;box-shadow:inset 0 0 18px #0008}
.material{position:absolute;bottom:0;width:100%;height:0%;background:linear-gradient(#f5d05c,#bd851e);transition:height .5s}
.level{text-align:center;font-size:34px;font-weight:bold;color:var(--yellow);font-variant-numeric:tabular-nums}
.status{text-align:center;padding:9px;color:var(--cyan);font-size:12px;font-weight:bold;letter-spacing:1px}
.metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.metric{padding:14px;background:var(--panel2);border:1px solid #3b4852;border-radius:4px;min-width:0}
.label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px}
.value{font-size:24px;font-weight:bold;margin-top:8px;overflow-wrap:anywhere;color:#f1f5f7;font-variant-numeric:tabular-nums}
.rows{font-size:12px;margin-top:16px}
.rows div{padding:11px 2px;border-bottom:1px solid #3a444d}
.ok{color:var(--green)}.err{color:var(--red)}
footer{text-align:center;padding:20px;color:#82909a;font-size:10px;letter-spacing:1px}
.chart{padding:12px}
canvas{display:block;width:100%;height:240px}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
button{background:#303b44;color:#eaf0f3;border:1px solid #52616c;border-radius:4px;padding:10px 15px;cursor:pointer;font-weight:bold;font-size:12px;letter-spacing:.4px}
button.active,button:hover{background:#245c49;border-color:var(--green)}
.note{font-size:11px;color:#9aa7b2;padding:0 4px 12px}
.content{padding:22px}
p{font-size:13px;color:#b1bdc5;line-height:1.6}
.gate{width:120px;height:120px;margin:24px auto;border:3px solid #788994;border-radius:8px;background:#151c22;display:flex;align-items:center;justify-content:center;font-size:48px;color:var(--cyan);box-shadow:inset 0 0 18px #0008}
.status{padding:14px;border:1px solid #3b4852;border-radius:4px;text-align:center;font-weight:bold;background:#26343d;color:var(--cyan);margin:20px 0}
.status.open{background:#40351e;border-color:#9a772b;color:var(--yellow)}
button:disabled{opacity:.5;cursor:wait}
.open{background:#246b49;color:white;border-color:#3b9b6b}.close{background:#38434c;color:white;border-color:#596771}
#mensagem{text-align:center;min-height:20px}
.note{font-size:11px;color:#9aa7b2}
@media(max-width:680px){.grid{grid-template-columns:1fr}main{padding:12px}}
@media(max-width:600px){main{padding:12px}.metrics{grid-template-columns:1fr 1fr}.value{font-size:21px}canvas{height:210px}}
</style></head><body>
<header>
<div><b>SUPERVISÓRIO DO SILO</b><div style="color:#64748b;font-size:11px;margin-top:5px">MONITORAMENTO EM TEMPO REAL</div></div>
<nav>
<a class="active" href="/">Home</a>
<a href="/graficos">Gráficos</a>
<a href="/comporta">Comporta</a>
</nav>
</header>
<main><div class="grid">
<section class="panel"><div class="ph">NÍVEL DO SILO</div><div class="body">
<div class="silo"><div class="material" id="material"></div></div>
<div class="level"><span id="nivel">--</span>%</div>
<div class="status" id="status">AGUARDANDO</div>
</div></section>
<section class="panel"><div class="ph">VARIÁVEIS DE PROCESSO</div><div class="body">
<div class="metrics">
<div class="metric"><div class="label">Temperatura</div><div class="value"><span id="temp">--</span> °C</div></div>
<div class="metric"><div class="label">Umidade</div><div class="value"><span id="umid">--</span> %</div></div>
<div class="metric"><div class="label">Distância</div><div class="value"><span id="dist">--</span> cm</div></div>
<div class="metric"><div class="label">Funcionamento</div><div class="value" style="font-size:14px" id="uptime">--</div></div>
</div>
<div class="rows">
<div>Ultrassônico: <b id="ultra">--</b></div>
<div>DHT11: <b id="dht">--</b></div>
<div>Comporta: <b id="gate">--</b></div>
</div>
</div></section>
</div></main>
<footer>SISTEMA DE MONITORAMENTO DE SILO • ESP32</footer>
<script>
async function atualizar(){
try{
let r=await fetch('/dados',{cache:'no-store'});
let d=await r.json();
document.getElementById('nivel').textContent=d.sensorUltrassonico?Math.round(d.nivel):'ERRO';
document.getElementById('material').style.height=d.sensorUltrassonico?d.nivel+'%':'0%';
document.getElementById('status').textContent=d.status;
document.getElementById('temp').textContent=d.temperatura===null?'--':Number(d.temperatura).toFixed(1);
document.getElementById('umid').textContent=d.umidade===null?'--':Number(d.umidade).toFixed(1);
document.getElementById('dist').textContent=d.distancia===null?'--':Number(d.distancia).toFixed(2);
document.getElementById('uptime').textContent=d.uptime;
let u=document.getElementById('ultra');
u.textContent=d.sensorUltrassonico?'OK':'ERRO';u.className=d.sensorUltrassonico?'ok':'err';
let h=document.getElementById('dht');
h.textContent=d.sensorDHT?'OK':'ERRO';h.className=d.sensorDHT?'ok':'err';
document.getElementById('gate').textContent=d.comportaAberta?'ABERTA':'FECHADA';
}catch(e){console.log(e)}
}
atualizar();setInterval(atualizar,1500);
</script></body></html>
)rawliteral";

  server.send(200, "text/html; charset=utf-8", html);
}

