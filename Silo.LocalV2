@media(max-width:600px){main{padding:12px}.metrics{grid-template-columns:1fr 1fr}.value{font-size:21px}canvas{height:210px}}
</style></head><body>
<header><div><b>SUPERVISÓRIO DO SILO</b><div style="color:#64748b;font-size:11px;margin-top:5px">HISTÓRICO DO PROCESSO</div></div>
<nav>
<a href="/">Home</a>
<a class="active" href="/graficos">Gráficos</a>
<a href="/comporta">Comporta</a>
</nav></header>
<main>
<div class="filters">
<button class="active" data-period="300">5 minutos</button>
<button data-period="900">15 minutos</button>
<button data-period="1800">30 minutos</button>
</div>
<div class="metrics">
<div class="metric"><div class="label">Nível atual</div><div class="value" id="nv">--</div></div>
<div class="metric"><div class="label">Temperatura</div><div class="value" id="tp">--</div></div>
<div class="metric"><div class="label">Umidade</div><div class="value" id="um">--</div></div>
</div>
<section class="panel"><div class="ph">NÍVEL DO SILO (%)</div><div class="chart"><canvas id="cNivel"></canvas></div></section>
<section class="panel"><div class="ph">TEMPERATURA (°C)</div><div class="chart"><canvas id="cTemp"></canvas></div></section>
<section class="panel"><div class="ph">UMIDADE (%)</div><div class="chart"><canvas id="cUmid"></canvas></div></section>
<div class="note" id="nota">Histórico temporário armazenado na memória da ESP32.</div>
</main>
<script>
let periodo=300,hist=[];
document.querySelectorAll('[data-period]').forEach(b=>{
b.onclick=()=>{
document.querySelectorAll('[data-period]').forEach(x=>x.classList.remove('active'));
b.classList.add('active');periodo=Number(b.dataset.period);desenharTodos();
};
});
function grafico(id,chave,cor,minFixo,maxFixo){
const c=document.getElementById(id),rect=c.getBoundingClientRect(),ratio=window.devicePixelRatio||1;
c.width=Math.max(1,rect.width*ratio);c.height=Math.max(1,rect.height*ratio);
const ctx=c.getContext('2d');ctx.setTransform(ratio,0,0,ratio,0,0);
const w=rect.width,h=rect.height,m={l:42,r:12,t:15,b:28},pw=w-m.l-m.r,ph=h-m.t-m.b;
ctx.clearRect(0,0,w,h);
const agora=hist.length?hist[hist.length-1].tempo:0;
const dados=hist.filter(d=>d.tempo>=agora-periodo&&d[chave]!==null&&Number.isFinite(d[chave]));
let ymin=minFixo,ymax=maxFixo;
if(ymin===null||ymax===null){
if(dados.length){let v=dados.map(d=>d[chave]),lo=Math.min(...v),hi=Math.max(...v),f=Math.max((hi-lo)*.2,1);ymin=Math.floor(lo-f);ymax=Math.ceil(hi+f);}
else{ymin=0;ymax=10;}
}
ctx.font='11px Arial';ctx.strokeStyle='#263244';ctx.fillStyle='#94a3b8';
for(let i=0;i<=4;i++){
let y=m.t+ph*i/4;ctx.beginPath();ctx.moveTo(m.l,y);ctx.lineTo(w-m.r,y);ctx.stroke();
ctx.textAlign='right';ctx.textBaseline='middle';ctx.fillText((ymax-(ymax-ymin)*i/4).toFixed(1),m.l-6,y);
}
if(!dados.length){ctx.textAlign='center';ctx.fillText('Aguardando dados...',w/2,h/2);return;}
ctx.strokeStyle=cor;ctx.lineWidth=2.5;ctx.beginPath();
dados.forEach((d,i)=>{
let x=m.l+Math.max(0,Math.min(1,(d.tempo-(agora-periodo))/periodo))*pw;
let y=m.t+(ymax-d[chave])/(ymax-ymin)*ph;
if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
});
ctx.stroke();
}
function desenharTodos(){
grafico('cNivel','nivel','#f59e0b',0,100);
grafico('cTemp','temperatura','#fb7185',null,null);
grafico('cUmid','umidade','#38bdf8',0,100);
let agora=hist.length?hist[hist.length-1].tempo:0;
let vis=hist.filter(d=>d.tempo>=agora-periodo);
document.getElementById('nota').textContent=vis.length+' amostras no período. Máximo de 30 minutos.';
}
async function atualizar(){
try{
let r=await fetch('/historico',{cache:'no-store'});hist=await r.json();
let n=hist.filter(d=>d.nivel!==null),t=hist.filter(d=>d.temperatura!==null),u=hist.filter(d=>d.umidade!==null);
document.getElementById('nv').textContent=n.length?Number(n[n.length-1].nivel).toFixed(1)+'%':'--';
document.getElementById('tp').textContent=t.length?Number(t[t.length-1].temperatura).toFixed(1)+' °C':'--';
document.getElementById('um').textContent=u.length?Number(u[u.length-1].umidade).toFixed(1)+'%':'--';
desenharTodos();
}catch(e){console.log(e)}
}
window.addEventListener('resize',desenharTodos);
atualizar();setInterval(atualizar,5000);
</script></body></html>
)rawliteral";

  server.send(200, "text/html; charset=utf-8", html);
}

