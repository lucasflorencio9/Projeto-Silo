#include <ESPmDNS.h>
#include <ESP32Servo.h>
#include <math.h>

// ==================================================
// CONFIGURACOES DO SISTEMA
// ==================================================
// PLACA: ESP32-S3 (Arduino IDE: ESP32S3 Dev Module)
// TFT ILI9341: CS=14, RST=21, DC=47, MOSI=45, SCLK=3, MISO=46, BL=9
// TOUCH XPT2046: CLK=42, CS=1,
//                MOSI=2, MISO=41
// ULTRASSONICO: TRIG=5, ECHO=18
// DHT11: DATA=15
// SERVO MG996R: SINAL=16 (fonte externa 5-6 V; GND comum)
// ATENCAO: ECHO do ultrassonico deve chegar ao ESP32-S3 com no maximo 3,3 V.

#define TRIG_PIN 5
#define ECHO_PIN 18
#define DHT_PIN 15
#define DHT_TYPE DHT11
// TFT ILI9341 - pinos confirmados nos testes
#define TFT_CS   14
#define TFT_RST  21
#define TFT_DC   47
#define TFT_MOSI 45
#define TFT_SCLK 3
#define TFT_MISO 46
#define TFT_BL   9

// Touch XPT2046 com navegacao por toque
#define TOUCH_CLK  42
#define TOUCH_CS   1
#define TOUCH_MOSI 2
#define TOUCH_MISO 41

// Sensores e atuador
#define SERVO_PIN 16

// CALIBRACAO: valores iniciais; revisar com o funil instalado.
const float DISTANCIA_VAZIO = 20.20;
const float DISTANCIA_CHEIO = 3.00;

const int ANGULO_FECHADO = 20;
const int ANGULO_ABERTO = 110;

const char* SSID_AP = "Silo-ESP32";
const char* SENHA_AP = "12345678";
const char* HOSTNAME = "silo";

SPIClass tftSPI(FSPI);
SPIClass touchSPI(HSPI);
Adafruit_ILI9341 tft(&tftSPI, TFT_DC, TFT_CS, TFT_RST);
XPT2046_Touchscreen touch(TOUCH_CS, -1);
DHT dht(DHT_PIN, DHT_TYPE);
WebServer server(80);
Servo servoComporta;

// ==================================================
// VARIAVEIS
// ==================================================

float distancia = -1;
float nivel = 0;
float temperatura = NAN;
float umidade = NAN;

bool ultrassonicoOK = false;
bool dhtOK = false;
bool comportaAberta = false;

enum StatusSilo {
  STATUS_ERRO,
  STATUS_BAIXO,
  STATUS_NORMAL,
  STATUS_ALTO,
  STATUS_CHEIO
};

StatusSilo statusAtual = STATUS_ERRO;

unsigned long ultimoUltrassonico = 0;
unsigned long ultimoDHT = 0;
unsigned long ultimaTFT = 0;
unsigned long ultimaGravacaoHistorico = 0;

const unsigned long INTERVALO_ULTRASSONICO = 1000;
const unsigned long INTERVALO_DHT = 2000;
const unsigned long INTERVALO_TFT = 1000;
const unsigned long INTERVALO_HISTORICO = 5000;

struct RegistroHistorico {
  unsigned long tempo;
  float nivel;
  float temperatura;
  float umidade;
  bool nivelOK;
  bool dhtValido;
};

const int MAX_REGISTROS = 360;
RegistroHistorico historico[MAX_REGISTROS];

int totalRegistros = 0;
int indiceHistorico = 0;

// ==================================================
// SENSOR ULTRASSONICO
// ==================================================

float medirDistancia() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  long duracao = pulseIn(ECHO_PIN, HIGH, 30000);

  if (duracao == 0) return -1;

  return duracao * 0.0343 / 2.0;
}

float medirDistanciaMedia() {
  float soma = 0;
  int validas = 0;

  for (int i = 0; i < 5; i++) {
    float leitura = medirDistancia();

    if (leitura > 0 && leitura < 400) {
      soma += leitura;
      validas++;
    }

    delay(20);
  }

  if (validas == 0) return -1;

  return soma / validas;
}

void calcularNivel() {
  if (!ultrassonicoOK || distancia < 0) return;

  nivel = ((DISTANCIA_VAZIO - distancia) /
          (DISTANCIA_VAZIO - DISTANCIA_CHEIO)) * 100.0;

  nivel = constrain(nivel, 0, 100);
}

void atualizarStatus() {
  if (!ultrassonicoOK) {
    statusAtual = STATUS_ERRO;
    return;
  }

  switch (statusAtual) {
    case STATUS_ERRO:
      if (nivel < 25) statusAtual = STATUS_BAIXO;
      else if (nivel < 75) statusAtual = STATUS_NORMAL;
      else if (nivel < 90) statusAtual = STATUS_ALTO;
      else statusAtual = STATUS_CHEIO;
      break;

    case STATUS_BAIXO:
      if (nivel >= 27) {
        if (nivel < 75) statusAtual = STATUS_NORMAL;
        else if (nivel < 90) statusAtual = STATUS_ALTO;
        else statusAtual = STATUS_CHEIO;
      }
      break;

    case STATUS_NORMAL:
      if (nivel < 23) statusAtual = STATUS_BAIXO;
      else if (nivel >= 77) {
        if (nivel < 90) statusAtual = STATUS_ALTO;
        else statusAtual = STATUS_CHEIO;
      }
      break;

    case STATUS_ALTO:
      if (nivel < 73) {
        if (nivel < 23) statusAtual = STATUS_BAIXO;
        else statusAtual = STATUS_NORMAL;
      } else if (nivel >= 92) {
        statusAtual = STATUS_CHEIO;
      }
      break;

    case STATUS_CHEIO:
      if (nivel < 88) {
        if (nivel < 73) {
          if (nivel < 23) statusAtual = STATUS_BAIXO;
          else statusAtual = STATUS_NORMAL;
        } else {
          statusAtual = STATUS_ALTO;
        }
      }
      break;
  }
}

String obterStatus() {
  switch (statusAtual) {
    case STATUS_BAIXO: return "BAIXO";
    case STATUS_NORMAL: return "NORMAL";
    case STATUS_ALTO: return "ALTO";
    case STATUS_CHEIO: return "CHEIO";
    default: return "ERRO SENSOR";
  }
}

void atualizarUltrassonico() {
  float novaDistancia = medirDistanciaMedia();

  if (novaDistancia > 0) {
    distancia = novaDistancia;
    ultrassonicoOK = true;
    calcularNivel();
    atualizarStatus();
  } else {
    ultrassonicoOK = false;
    statusAtual = STATUS_ERRO;
  }
}

// ==================================================
// SENSOR DHT11
// ==================================================

void atualizarDHT() {
  float t = dht.readTemperature();
  float u = dht.readHumidity();

  if (!isnan(t) && !isnan(u)) {
    temperatura = t;
    umidade = u;
    dhtOK = true;
  } else {
    dhtOK = false;
  }
}

// ==================================================
// TEMPO DE FUNCIONAMENTO
// ==================================================

String obterUptime() {
  unsigned long s = millis() / 1000UL;
  unsigned long dias = s / 86400UL;
  s %= 86400UL;

  unsigned long horas = s / 3600UL;
  s %= 3600UL;

  unsigned long minutos = s / 60UL;
  s %= 60UL;

  char buffer[40];

  snprintf(buffer, sizeof(buffer),
    "%lu d %02lu:%02lu:%02lu",
    dias, horas, minutos, s);

  return String(buffer);
}

// ==================================================
// HISTORICO DOS GRAFICOS
// ==================================================

void registrarHistorico() {
  unsigned long agora = millis();

  if (totalRegistros > 0 &&
      agora - ultimaGravacaoHistorico < INTERVALO_HISTORICO) {
    return;
  }

  ultimaGravacaoHistorico = agora;

  RegistroHistorico &r = historico[indiceHistorico];

  r.tempo = agora / 1000UL;
  r.nivel = nivel;
  r.temperatura = temperatura;
  r.umidade = umidade;
  r.nivelOK = ultrassonicoOK;
  r.dhtValido = dhtOK;

  indiceHistorico = (indiceHistorico + 1) % MAX_REGISTROS;

  if (totalRegistros < MAX_REGISTROS) {
    totalRegistros++;
  }
}

// ==================================================
// INTERFACE TFT + TOUCH
// ==================================================

enum TelaAtual { TELA_HOME, TELA_GRAFICOS, TELA_COMPORTA };
TelaAtual telaAtual = TELA_HOME;

enum GraficoAtual { GRAF_NIVEL, GRAF_TEMPERATURA, GRAF_UMIDADE };
GraficoAtual graficoAtual = GRAF_NIVEL;
int periodoGrafico = 300;

const int TOUCH_X_MIN = 250;
const int TOUCH_X_MAX = 3850;
const int TOUCH_Y_MIN = 250;
const int TOUCH_Y_MAX = 3850;
const bool TOUCH_INVERTER_X = false;
const bool TOUCH_INVERTER_Y = false;
const bool TOUCH_TROCAR_EIXOS = false;

const uint16_t COR_FUNDO = 0x18E3;       // grafite industrial
const uint16_t COR_CABECALHO = 0x2124;   // painel grafite
const uint16_t COR_CARTAO = 0x2965;       // cinza de painel
const uint16_t COR_BORDA = 0x4A49;        // borda técnica
const uint16_t COR_TEXTO = 0xFFFF;
const uint16_t COR_SUAVE = 0xBDF7;
const uint16_t COR_AZUL = 0x04A0;        // azul de seleção
const uint16_t COR_VERDE = 0x07E0;       // operação normal
const uint16_t COR_LARANJA = 0xFFE0;     // atenção
const uint16_t COR_VERMELHO = 0xF800;    // alarme
const uint16_t COR_CIANO = 0x07FF;       // informação

unsigned long ultimoToque = 0;
const unsigned long DEBOUNCE_TOQUE = 250;
bool telaPrecisaRedesenhar = true;
unsigned long ultimaAtualizacaoGrafico = 0;

void desenharCabecalho(const char *subtitulo) {
  tft.fillScreen(COR_FUNDO);
  tft.fillRect(0, 0, 320, 36, COR_CABECALHO);
  tft.fillRect(0, 34, 320, 2, COR_VERDE);
  tft.setTextColor(COR_TEXTO);
  tft.setTextSize(2);
  tft.setCursor(10, 10);
  tft.print("SILO  |  SUPERVISAO");
  tft.setTextSize(1);
  tft.setTextColor(COR_CIANO);
  tft.setCursor(11, 43);
  tft.print("SISTEMA SCADA  /  ");
  tft.setTextColor(COR_SUAVE);
  tft.print(subtitulo);
}

void desenharNavegacao() {
  const int y = 207, h = 33, w = 104;
  const char *nomes[] = {"HOME", "GRAFICOS", "COMPORTA"};
  for (int i = 0; i < 3; i++) {
    uint16_t cor = ((int)telaAtual == i) ? COR_AZUL : COR_CARTAO;
    tft.fillRoundRect(i * 107 + 2, y, w, h, 6, cor);
    tft.drawRoundRect(i * 107 + 2, y, w, h, 6, COR_BORDA);
    tft.setTextSize(1);
    tft.setTextColor(COR_TEXTO);
    int16_t x1, y1;
    uint16_t tw, th;
    tft.getTextBounds(nomes[i], 0, 0, &x1, &y1, &tw, &th);
    tft.setCursor(i * 107 + 2 + (w - tw) / 2, y + 13);
    tft.print(nomes[i]);
  }
}

uint16_t corDoStatus() {
  if (!ultrassonicoOK) return COR_VERMELHO;
  if (statusAtual == STATUS_BAIXO) return COR_VERMELHO;
  if (statusAtual == STATUS_NORMAL) return COR_VERDE;
  if (statusAtual == STATUS_ALTO) return COR_LARANJA;
  return COR_CIANO;
}

void desenharCartao(int x, int y, int w, int h, const char *titulo) {
  tft.fillRoundRect(x, y, w, h, 8, COR_CARTAO);
  tft.drawRoundRect(x, y, w, h, 8, COR_BORDA);
  tft.setTextSize(1);
  tft.setTextColor(COR_SUAVE);
  tft.setCursor(x + 9, y + 8);
  tft.print(titulo);
}

void desenharHome() {
  desenharCabecalho("MONITORAMENTO EM TEMPO REAL");

  desenharCartao(8, 58, 148, 140, "NIVEL DO SILO");
  tft.setTextColor(ultrassonicoOK ? COR_LARANJA : COR_VERMELHO, COR_CARTAO);
  tft.setTextSize(4);
  tft.setCursor(18, 82);
  if (ultrassonicoOK) {
    tft.print((int)round(nivel));
    tft.print("%");
  } else {
    tft.setTextSize(2);
    tft.print("ERRO");
  }

  int sx = 112, sy = 82, sw = 28, sh = 88;
  tft.drawRoundRect(sx, sy, sw, sh, 8, COR_SUAVE);
  tft.drawFastHLine(sx + 5, sy + 8, sw - 10, COR_SUAVE);
  if (ultrassonicoOK) {
    int fillH = (int)(constrain(nivel, 0.0f, 100.0f) * (sh - 12) / 100.0f);
    uint16_t c = nivel < 25 ? COR_VERMELHO : (nivel < 75 ? COR_LARANJA : COR_VERDE);
    if (fillH > 0) tft.fillRoundRect(sx + 4, sy + sh - 6 - fillH, sw - 8, fillH, 4, c);
  }
  tft.setTextSize(1);
  tft.setTextColor(corDoStatus(), COR_CARTAO);
  tft.setCursor(18, 145);
  tft.print(obterStatus());

  desenharCartao(164, 58, 148, 65, "TEMPERATURA");
  tft.setTextSize(2);
  tft.setTextColor(dhtOK ? COR_TEXTO : COR_VERMELHO, COR_CARTAO);
  tft.setCursor(174, 85);
  if (dhtOK) { tft.print(temperatura, 1); tft.print(" C"); }
  else tft.print("-- C");

  desenharCartao(164, 132, 148, 66, "UMIDADE");
  tft.setTextSize(2);
  tft.setTextColor(dhtOK ? COR_CIANO : COR_VERMELHO, COR_CARTAO);
  tft.setCursor(174, 159);
  if (dhtOK) { tft.print(umidade, 0); tft.print(" %"); }
  else tft.print("-- %");

  tft.setTextSize(1);
  tft.setTextColor(COR_SUAVE);
  tft.setCursor(12, 188);
  tft.print("DIST: ");
  tft.setTextColor(ultrassonicoOK ? COR_TEXTO : COR_VERMELHO);
  if (ultrassonicoOK) { tft.print(distancia, 1); tft.print(" cm"); }
  else tft.print("SEM ECO");

  desenharNavegacao();
}

float valorDoRegistro(const RegistroHistorico &r) {
  if (graficoAtual == GRAF_NIVEL) return r.nivelOK ? r.nivel : NAN;
  if (!r.dhtValido) return NAN;
  return graficoAtual == GRAF_TEMPERATURA ? r.temperatura : r.umidade;
}

void desenharPlotGrafico() {
  const int gx = 34, gy = 121, gw = 276, gh = 67;
  tft.fillRoundRect(8, 116, 304, 82, 6, COR_CARTAO);
  for (int i = 0; i <= 4; i++) {
    int yy = gy + i * (gh / 4);
    tft.drawFastHLine(gx, yy, gw, 0x39E7);
  }

  unsigned long agora = millis() / 1000UL;
  float minV = 0, maxV = 100;
  if (graficoAtual == GRAF_TEMPERATURA) maxV = 50;

  int pontos = 0;
  int ultimoX = -1, ultimoY = -1;
  uint16_t corLinha = graficoAtual == GRAF_NIVEL ? COR_LARANJA :
                      (graficoAtual == GRAF_TEMPERATURA ? COR_VERMELHO : COR_CIANO);

  int inicio = (indiceHistorico - totalRegistros + MAX_REGISTROS) % MAX_REGISTROS;
  for (int i = 0; i < totalRegistros; i++) {
    int pos = (inicio + i) % MAX_REGISTROS;
    RegistroHistorico &r = historico[pos];
    if (agora < r.tempo || agora - r.tempo > (unsigned long)periodoGrafico) continue;

    float v = valorDoRegistro(r);
    if (isnan(v)) continue;
    int x = gx + (int)((float)(r.tempo - (agora - periodoGrafico)) * gw / periodoGrafico);
    int y = gy + gh - (int)((constrain(v, minV, maxV) - minV) * gh / (maxV - minV));
    x = constrain(x, gx, gx + gw);
    y = constrain(y, gy, gy + gh);
    if (ultimoX >= 0) tft.drawLine(ultimoX, ultimoY, x, y, corLinha);
    tft.fillCircle(x, y, 2, corLinha);
    ultimoX = x;
    ultimoY = y;
    pontos++;
  }

  tft.setTextSize(1);
  tft.setTextColor(COR_SUAVE, COR_CARTAO);
  tft.setCursor(10, 123);
  tft.print(maxV, 0);
  tft.setCursor(10, 181);
  tft.print(minV, 0);
  tft.setCursor(12, 188);
  tft.print(pontos);
  tft.print(" amostras");
}

void desenharGrafico() {
  desenharCabecalho("HISTORICO DO PROCESSO");

  const char *tipos[] = {"NIVEL", "TEMP.", "UMID."};
  for (int i = 0; i < 3; i++) {
    int x = 8 + i * 104;
    uint16_t c = ((int)graficoAtual == i) ? COR_AZUL : COR_CARTAO;
    tft.fillRoundRect(x, 57, 96, 25, 5, c);
    tft.drawRoundRect(x, 57, 96, 25, 5, COR_BORDA);
    tft.setTextSize(1);
    tft.setTextColor(COR_TEXTO);
    tft.setCursor(x + 29, 66);
    tft.print(tipos[i]);
  }

  const int periodos[] = {300, 900, 1800};
  const char *periodosTxt[] = {"5 MIN", "15 MIN", "30 MIN"};
  for (int i = 0; i < 3; i++) {
    int x = 8 + i * 104;
    uint16_t c = (periodoGrafico == periodos[i]) ? COR_VERDE : COR_CARTAO;
    tft.fillRoundRect(x, 88, 96, 22, 5, c);
    tft.drawRoundRect(x, 88, 96, 22, 5, COR_BORDA);
    tft.setTextSize(1);
    tft.setTextColor(COR_TEXTO);
    tft.setCursor(x + 29, 95);
    tft.print(periodosTxt[i]);
  }

  desenharPlotGrafico();
  desenharNavegacao();
}

