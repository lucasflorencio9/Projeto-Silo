.rows div{padding:11px 2px;border-bottom:1px solid #3a444d}
.ok{color:var(--green)}.err{color:var(--red)}
footer{text-align:center;padding:20px;color:#82909a;font-size:10px;letter-spacing:1px}
.chart{padding:12px}
canvas{display:block;width:100%;height:240px}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
button{background:#303b44;color:#eaf0f3;border:1px solid #52616c;border-radius:4px;padding:10px 15px;cursor:pointer;font-weight:bold;font-size:12px;letter-spacing:.4px}
button.active,button:hover{background:#245c49;border-color:var(--green)}
.note{font-size:11px;color:#9aa7b2;padding:0 4px 12px}
.content{padding:22px}
p{font-size:13px;color:#b1bdc5;line-height:1.6}
.gate{width:120px;height:120px;margin:24px auto;border:3px solid #788994;border-radius:8px;background:#151c22;display:flex;align-items:center;justify-content:center;font-size:48px;color:var(--cyan);box-shadow:inset 0 0 18px #0008}
.status{padding:14px;border:1px solid #3b4852;border-radius:4px;text-align:center;font-weight:bold;background:#26343d;color:var(--cyan);margin:20px 0}
.status.open{background:#40351e;border-color:#9a772b;color:var(--yellow)}
button:disabled{opacity:.5;cursor:wait}
.open{background:#246b49;color:white;border-color:#3b9b6b}.close{background:#38434c;color:white;border-color:#596771}
#mensagem{text-align:center;min-height:20px}
.note{font-size:11px;color:#9aa7b2}
@media(max-width:680px){.grid{grid-template-columns:1fr}main{padding:12px}}
@media(max-width:600px){main{padding:12px}.metrics{grid-template-columns:1fr 1fr}.value{font-size:21px}canvas{height:210px}}
</style></head><body>
<header><div><b>SUPERVISÓRIO DO SILO</b><div style="color:#64748b;font-size:11px;margin-top:5px">CONTROLE DA COMPORTA</div></div>
<nav>
<a href="/">Home</a>
<a href="/graficos">Gráficos</a>
<a class="active" href="/comporta">Comporta</a>
</nav></header>
<main><section class="panel"><div class="ph">CONTROLE DA COMPORTA</div>
<div class="content">
<p>Utilize os botões para abrir ou fechar a comporta acionada pelo servo MG996R.</p>
<div class="gate" id="icone">▤</div>
<div class="status" id="estado">CONSULTANDO...</div>
<button class="open" id="btnAbrir" onclick="acionar('/abrir')">ABRIR COMPORTA</button>
<button class="close" id="btnFechar" onclick="acionar('/fechar')">FECHAR COMPORTA</button>
<p id="mensagem" aria-live="polite"></p>
<p class="note">O estado mostrado corresponde ao último comando enviado. Sem um sensor de posição, não há confirmação física da abertura ou do fechamento.</p>
</div></section></main>
<script>
const estadoEl=document.getElementById('estado');
const mensagemEl=document.getElementById('mensagem');
const iconeEl=document.getElementById('icone');
const botoes=[document.getElementById('btnAbrir'),document.getElementById('btnFechar')];
function mostrarEstado(aberta){
estadoEl.textContent=aberta?'COMPORTA ABERTA':'COMPORTA FECHADA';
estadoEl.className=aberta?'status open':'status';
iconeEl.textContent=aberta?'▱':'▤';
}
async function consultar(){
try{let r=await fetch('/estadoComporta',{cache:'no-store'});if(!r.ok)throw Error();let d=await r.json();mostrarEstado(d.aberta);}
catch(e){estadoEl.textContent='SEM COMUNICAÇÃO';}
}
async function acionar(url){
botoes.forEach(b=>b.disabled=true);mensagemEl.textContent='Enviando comando...';
try{
let r=await fetch(url,{method:'POST'});let d=await r.json();if(!r.ok)throw Error();
mostrarEstado(d.aberta);mensagemEl.textContent=d.mensagem;
}catch(e){mensagemEl.textContent='Falha de comunicação com a ESP32.';}
finally{botoes.forEach(b=>b.disabled=false);}
}
consultar();
</script></body></html>
)rawliteral";

  server.send(200, "text/html; charset=utf-8", html);
}

// ==================================================
// CONTROLE DA COMPORTA
// ==================================================

void handleAbrirComporta() {
  servoComporta.write(ANGULO_ABERTO);
  comportaAberta = true;

  server.send(200, "application/json",
    "{\"aberta\":true,\"mensagem\":\"Comando de abertura enviado.\"}");
}

void handleFecharComporta() {
  servoComporta.write(ANGULO_FECHADO);
  comportaAberta = false;

  server.send(200, "application/json",
    "{\"aberta\":false,\"mensagem\":\"Comando de fechamento enviado.\"}");
}

void handleEstadoComporta() {
  String json = "{\"aberta\":";
  json += comportaAberta ? "true" : "false";
  json += "}";

  server.send(200, "application/json", json);
}

// ==================================================
// API DE DADOS ATUAIS
// ==================================================

void handleDados() {
  String json = "{";

  json += "\"nivel\":";
  json += String(nivel, 1);

  json += ",\"temperatura\":";
  json += dhtOK ? String(temperatura, 1) : "null";

  json += ",\"umidade\":";
  json += dhtOK ? String(umidade, 1) : "null";

  json += ",\"distancia\":";
  json += ultrassonicoOK ? String(distancia, 2) : "null";

  json += ",\"status\":\"";
  json += obterStatus();
  json += "\"";

  json += ",\"sensorUltrassonico\":";
  json += ultrassonicoOK ? "true" : "false";

  json += ",\"sensorDHT\":";
  json += dhtOK ? "true" : "false";

  json += ",\"comportaAberta\":";
  json += comportaAberta ? "true" : "false";

  json += ",\"uptime\":\"";
  json += obterUptime();
  json += "\"}";

  server.send(200, "application/json", json);
}

// ==================================================
// API DO HISTORICO
// ==================================================

void handleHistorico() {
  String json;
  json.reserve(18000);
  json = "[";

  int inicio = (indiceHistorico - totalRegistros + MAX_REGISTROS)
               % MAX_REGISTROS;

  for (int i = 0; i < totalRegistros; i++) {
    int pos = (inicio + i) % MAX_REGISTROS;
    RegistroHistorico &r = historico[pos];

    if (i > 0) json += ",";

    json += "{\"tempo\":";
    json += String(r.tempo);

    json += ",\"nivel\":";
    json += r.nivelOK ? String(r.nivel, 1) : "null";

    json += ",\"temperatura\":";
    json += r.dhtValido ? String(r.temperatura, 1) : "null";

    json += ",\"umidade\":";
    json += r.dhtValido ? String(r.umidade, 1) : "null";

    json += "}";
  }

  json += "]";
  server.send(200, "application/json", json);
}

// ==================================================
// WIFI E MDNS
// ==================================================

void configurarWiFi() {
  WiFi.mode(WIFI_AP);
  WiFi.softAP(SSID_AP, SENHA_AP);

  Serial.println();
  Serial.println("================================");
  Serial.println("    MONITORAMENTO DO SILO");
  Serial.println("================================");
  Serial.print("Rede Wi-Fi: ");
  Serial.println(SSID_AP);
  Serial.print("Senha: ");
  Serial.println(SENHA_AP);
  Serial.print("IP local: ");
  Serial.println(WiFi.softAPIP());

  if (MDNS.begin(HOSTNAME)) {
    MDNS.addService("http", "tcp", 80);
    Serial.println("mDNS iniciado com sucesso.");
    Serial.println("Endereco principal: http://silo.local");
  } else {
    Serial.println("Falha ao iniciar mDNS.");
  }
}

// ==================================================
// CONFIGURAR ROTAS DO SERVIDOR
// ==================================================

void configurarServidor() {
  server.on("/", HTTP_GET, handleRoot);
  server.on("/graficos", HTTP_GET, handleGraficos);
  server.on("/comporta", HTTP_GET, handleComporta);

  server.on("/dados", HTTP_GET, handleDados);
  server.on("/historico", HTTP_GET, handleHistorico);

  server.on("/abrir", HTTP_POST, handleAbrirComporta);
  server.on("/fechar", HTTP_POST, handleFecharComporta);
  server.on("/estadoComporta", HTTP_GET, handleEstadoComporta);

  server.onNotFound([]() {
    server.send(404, "text/plain; charset=utf-8",
                "Pagina nao encontrada. Acesse http://silo.local");
  });

  server.begin();
  Serial.println("Servidor HTTP iniciado.");
}

// ==================================================
// SETUP
// ==================================================

void setup() {
  Serial.begin(115200);

  pinMode(TRIG_PIN, OUTPUT);
  digitalWrite(TRIG_PIN, LOW);
  pinMode(ECHO_PIN, INPUT);

  dht.begin();

  inicializarTFT();

  // Inicializar servo na posicao fechada
  servoComporta.setPeriodHertz(50);
  servoComporta.attach(SERVO_PIN, 500, 2400);
  servoComporta.write(ANGULO_FECHADO);
  comportaAberta = false;

  delay(1000);

  // Iniciar rede, mDNS e servidor
  configurarWiFi();
  configurarServidor();

  // Primeiras leituras
  atualizarUltrassonico();
  atualizarDHT();
  atualizarTFT();
  registrarHistorico();

  unsigned long agora = millis();
  ultimoUltrassonico = agora;
  ultimoDHT = agora;
  ultimaTFT = agora;

  Serial.println();
  Serial.println("================================");
  Serial.println("       SISTEMA PRONTO - TFT");
  Serial.println("================================");
  Serial.println("Pinos: TRIG=5 ECHO=18 DHT=15 SERVO=16");
  Serial.println("TFT: CS14 RST21 DC47 MOSI45 SCLK3 MISO46 BL9");
  Serial.println("TOUCH: CLK42 CS1 MOSI2 MISO41");
  Serial.println("================================");
  Serial.println("HOME:      http://silo.local/");
  Serial.println("GRAFICOS:  http://silo.local/graficos");
  Serial.println("COMPORTA:  http://silo.local/comporta");
  Serial.println("================================");
}

// ==================================================
// LOOP PRINCIPAL
// ==================================================

void loop() {
  server.handleClient();
  processarToque();

  unsigned long agora = millis();

  if (agora - ultimoUltrassonico >= INTERVALO_ULTRASSONICO) {
    ultimoUltrassonico = agora;
    atualizarUltrassonico();
  }

  if (agora - ultimoDHT >= INTERVALO_DHT) {
    ultimoDHT = agora;
    atualizarDHT();
  }

  if (agora - ultimaTFT >= INTERVALO_TFT) {
    ultimaTFT = agora;
    atualizarTFT();
  }

  registrarHistorico();
}
