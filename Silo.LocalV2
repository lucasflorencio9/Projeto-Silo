void desenharTelaAtual() {
  if (telaAtual == TELA_HOME) desenharHome();
  else if (telaAtual == TELA_GRAFICOS) desenharGrafico();
  else desenharComporta();
  telaPrecisaRedesenhar = false;
}

bool lerToque(int &x, int &y) {
  if (!touch.touched()) return false;
  TS_Point p = touch.getPoint();

  int rx = p.x;
  int ry = p.y;
  if (TOUCH_TROCAR_EIXOS) {
    int temp = rx; rx = ry; ry = temp;
  }

  x = map(rx, TOUCH_X_MIN, TOUCH_X_MAX, 0, 319);
  y = map(ry, TOUCH_Y_MIN, TOUCH_Y_MAX, 0, 239);
  if (TOUCH_INVERTER_X) x = 319 - x;
  if (TOUCH_INVERTER_Y) y = 239 - y;
  x = constrain(x, 0, 319);
  y = constrain(y, 0, 239);
  return true;
}

void processarToque() {
  int x, y;
  if (!lerToque(x, y)) return;
  if (millis() - ultimoToque < DEBOUNCE_TOQUE) return;
  ultimoToque = millis();

  if (y >= 207) {
    if (x < 106) telaAtual = TELA_HOME;
    else if (x < 213) telaAtual = TELA_GRAFICOS;
    else telaAtual = TELA_COMPORTA;
    telaPrecisaRedesenhar = true;
    return;
  }

  if (telaAtual == TELA_GRAFICOS) {
    if (y >= 55 && y <= 84) {
      if (x < 107) graficoAtual = GRAF_NIVEL;
      else if (x < 213) graficoAtual = GRAF_TEMPERATURA;
      else graficoAtual = GRAF_UMIDADE;
      telaPrecisaRedesenhar = true;
    } else if (y >= 86 && y <= 112) {
      if (x < 107) periodoGrafico = 300;
      else if (x < 213) periodoGrafico = 900;
      else periodoGrafico = 1800;
      telaPrecisaRedesenhar = true;
    }
  } else if (telaAtual == TELA_COMPORTA && y >= 125 && y <= 195) {
    if (x < 160) {
      servoComporta.write(ANGULO_ABERTO);
      comportaAberta = true;
    } else {
      servoComporta.write(ANGULO_FECHADO);
      comportaAberta = false;
    }
    atualizarEstadoComportaTFT();
  }
}

void atualizarTFT() {
  // Uma tela inteira so e redesenhada quando o usuario troca de pagina
  // ou altera uma opcao do grafico.
  if (telaPrecisaRedesenhar) {
    desenharTelaAtual();
    ultimaAtualizacaoGrafico = millis();
    return;
  }

  if (telaAtual == TELA_HOME) {
    atualizarHomeDinamica();
  } else if (telaAtual == TELA_GRAFICOS &&
             millis() - ultimaAtualizacaoGrafico >= 5000) {
    desenharPlotGrafico();
    ultimaAtualizacaoGrafico = millis();
  }
  // Na tela COMPORTA nao ha redesenho periodico. O estado e atualizado
  // imediatamente apos o toque que envia o comando ao servo.
}

void inicializarTFT() {
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);
  tftSPI.begin(TFT_SCLK, TFT_MISO, TFT_MOSI, TFT_CS);
  tft.begin(20000000);
  tft.setRotation(1);

  touchSPI.begin(TOUCH_CLK, TOUCH_MISO, TOUCH_MOSI, TOUCH_CS);
  touch.begin(touchSPI);
  touch.setRotation(1);

  tft.fillScreen(COR_FUNDO);
  tft.setTextColor(COR_TEXTO);
  tft.setTextSize(2);
  tft.setCursor(25, 75);
  tft.println("SUPERVISORIO DO SILO");
  tft.setTextSize(1);
  tft.setCursor(25, 110);
  tft.println("Inicializando tela e touch...");
}

