  );
}


// =====================================================
// SERVIDOR
// =====================================================

void configurarServidor() {

  server.on(
    "/",
    handleRoot
  );


  server.on(
    "/dados",
    handleDados
  );


  server.begin();


  Serial.println(
    "Servidor HTTP: OK"
  );
}


// =====================================================
// SETUP
// =====================================================

void setup() {


  Serial.begin(
    115200
  );


  // ===================================================
  // ULTRASSÔNICO
  // ===================================================

  pinMode(
    TRIG_PIN,
    OUTPUT
  );


  pinMode(
    ECHO_PIN,
    INPUT
  );


  // ===================================================
  // DHT
  // ===================================================

  dht.begin();


  // ===================================================
  // OLED
  // ===================================================

  Wire.begin(
    OLED_SDA,
    OLED_SCL
  );


  if (
    !display.begin(
      SSD1306_SWITCHCAPVCC,
      0x3C
    )
  ) {

    Serial.println(
      "Erro ao iniciar OLED!"
    );


    while (true);
  }


  // ===================================================
  // TELA INICIAL
  // ===================================================

  display.clearDisplay();


  display.setTextColor(
    SSD1306_WHITE
  );


  display.setTextSize(1);


  display.setCursor(
    20,
    0
  );


  display.println(
    "MONITORAMENTO"
  );


  display.setCursor(
    35,
    12
  );


  display.println(
    "DO SILO"
  );


  display.setCursor(
    0,
    30
  );


  display.println(
    "Wi-Fi:"
  );


  display.println(
    "Silo-ESP32"
  );


  display.setCursor(
    0,
    50
  );


  display.println(
    "silo.local"
  );


  display.display();


  delay(3000);


  // ===================================================
  // WI-FI
  // ===================================================

  configurarWiFi();


  // ===================================================
  // SERVIDOR
  // ===================================================

  configurarServidor();


  // ===================================================
  // PRIMEIRAS LEITURAS
  // ===================================================

  atualizarUltrassonico();

  atualizarDHT();

  atualizarOLED();


  Serial.println();

  Serial.println(
    "================================"
  );

  Serial.println(
    " SISTEMA PRONTO"
  );

  Serial.println(
    "================================"
  );

  Serial.println(
    "Acesso principal:"
  );

  Serial.println(
    "http://silo.local"
  );

  Serial.println();

  Serial.println(
    "Acesso alternativo:"
  );

  Serial.println(
    "http://192.168.4.1"
  );

  Serial.println(
    "================================"
  );
}


// =====================================================
// LOOP
// =====================================================

void loop() {


  // ===================================================
  // SERVIDOR
  // ===================================================

  server.handleClient();


  unsigned long agora =
    millis();


  // ===================================================
  // ULTRASSÔNICO - 1 SEGUNDO
  // ===================================================

  if (
    agora - ultimoUltrassonico >=
    INTERVALO_ULTRASSONICO
  ) {

    ultimoUltrassonico =
      agora;


    atualizarUltrassonico();
  }


  // ===================================================
  // DHT11 - 2 SEGUNDOS
  // ===================================================

  if (
    agora - ultimoDHT >=
    INTERVALO_DHT
  ) {

    ultimoDHT =
      agora;


    atualizarDHT();
  }


  // ===================================================
  // OLED - 1 SEGUNDO
  // ===================================================

  if (
    agora - ultimoOLED >=
    INTERVALO_OLED
  ) {

    ultimoOLED =
      agora;


    atualizarOLED();
  }
}

