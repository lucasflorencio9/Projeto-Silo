enum StatusSilo {

  STATUS_ERRO,

  STATUS_BAIXO,

  STATUS_NORMAL,

  STATUS_ALTO,

  STATUS_CHEIO
};


StatusSilo statusAtual = STATUS_ERRO;


// =====================================================
// MEDIR DISTÂNCIA
// =====================================================

float medirDistancia() {

  digitalWrite(
    TRIG_PIN,
    LOW
  );

  delayMicroseconds(2);


  digitalWrite(
    TRIG_PIN,
    HIGH
  );

  delayMicroseconds(10);


  digitalWrite(
    TRIG_PIN,
    LOW
  );


  long duracao =
    pulseIn(
      ECHO_PIN,
      HIGH,
      30000
    );


  if (duracao == 0) {

    return -1;
  }


  float distanciaMedida =
    duracao * 0.0343 / 2.0;


  return distanciaMedida;
}


// =====================================================
// MÉDIA DO ULTRASSÔNICO
// =====================================================

float medirDistanciaMedia() {

  float soma = 0;

  int validas = 0;


  for (int i = 0; i < 5; i++) {

    float leitura =
      medirDistancia();


    if (
      leitura > 0 &&
      leitura < 400
    ) {

      soma += leitura;

      validas++;
    }


    delay(20);
  }


  if (validas == 0) {

    return -1;
  }


  return soma / validas;
}


// =====================================================
// CALCULAR NÍVEL
// =====================================================

void calcularNivel() {

  if (
    !ultrassonicoOK ||
    distancia < 0
  ) {

    return;
  }


  nivel =
    (
      (DISTANCIA_VAZIO - distancia) /
      (DISTANCIA_VAZIO - DISTANCIA_CHEIO)
    ) * 100.0;


  if (nivel < 0) {

    nivel = 0;
  }


  if (nivel > 100) {

    nivel = 100;
  }
}


// =====================================================
// ATUALIZAR STATUS
// =====================================================

void atualizarStatus() {

  if (!ultrassonicoOK) {

    statusAtual = STATUS_ERRO;

    return;
  }


  switch (statusAtual) {


    case STATUS_ERRO:

      if (nivel < 25) {

        statusAtual = STATUS_BAIXO;

      } else if (nivel < 75) {

        statusAtual = STATUS_NORMAL;

      } else if (nivel < 90) {

        statusAtual = STATUS_ALTO;

      } else {

        statusAtual = STATUS_CHEIO;
      }

      break;


    case STATUS_BAIXO:

      if (nivel >= 27) {

        if (nivel < 75) {

          statusAtual = STATUS_NORMAL;

        } else if (nivel < 90) {

          statusAtual = STATUS_ALTO;

        } else {

          statusAtual = STATUS_CHEIO;
        }
      }

      break;


    case STATUS_NORMAL:

      if (nivel < 23) {

        statusAtual = STATUS_BAIXO;

      } else if (nivel >= 77) {

        if (nivel < 90) {

          statusAtual = STATUS_ALTO;

        } else {

          statusAtual = STATUS_CHEIO;
        }
      }

      break;


    case STATUS_ALTO:

      if (nivel < 73) {

        if (nivel < 23) {

          statusAtual = STATUS_BAIXO;

        } else {

          statusAtual = STATUS_NORMAL;
        }

      } else if (nivel >= 92) {

        statusAtual = STATUS_CHEIO;
      }

      break;


    case STATUS_CHEIO:

      if (nivel < 88) {

        if (nivel < 73) {

          if (nivel < 23) {

            statusAtual = STATUS_BAIXO;

          } else {

            statusAtual = STATUS_NORMAL;
          }

        } else {

          statusAtual = STATUS_ALTO;
        }
      }

      break;
  }
}


// =====================================================
// TEXTO DO STATUS
// =====================================================

String obterStatus() {

  switch (statusAtual) {

    case STATUS_BAIXO:
      return "BAIXO";

    case STATUS_NORMAL:
      return "NORMAL";

    case STATUS_ALTO:
      return "ALTO";

    case STATUS_CHEIO:
      return "CHEIO";

    default:
      return "ERRO SENSOR";
  }
}


// =====================================================
// LEITURA ULTRASSÔNICO
// =====================================================

void atualizarUltrassonico() {

  float novaDistancia =
    medirDistanciaMedia();


  if (novaDistancia > 0) {

    distancia =
      novaDistancia;

    ultrassonicoOK =
      true;

    calcularNivel();

    atualizarStatus();

  } else {

    ultrassonicoOK =
      false;

    statusAtual =
      STATUS_ERRO;

    // Mantém o último nível válido.
  }
}


// =====================================================
// LEITURA DHT11
// =====================================================

void atualizarDHT() {

  float novaTemperatura =
    dht.readTemperature();


  float novaUmidade =
    dht.readHumidity();


  if (
    !isnan(novaTemperatura) &&
    !isnan(novaUmidade)
  ) {

    temperatura =
      novaTemperatura;

    umidade =
      novaUmidade;

    dhtOK =
      true;

  } else {

    dhtOK =
      false;

    // Mantém os últimos valores válidos.
  }
}


// =====================================================
// UPTIME
// =====================================================

String obterUptime() {

  unsigned long segundos =
    millis() / 1000;


  unsigned long dias =
    segundos / 86400;

  segundos %= 86400;


  unsigned long horas =
    segundos / 3600;

  segundos %= 3600;


  unsigned long minutos =
    segundos / 60;

  segundos %= 60;


  char buffer[40];


  sprintf(
    buffer,
    "%lu d %02lu:%02lu:%02lu",
    dias,
    horas,
    minutos,
    segundos
  );


  return String(buffer);
}


// =====================================================
// OLED
// =====================================================

void atualizarOLED() {

  display.clearDisplay();

  display.setTextColor(
    SSD1306_WHITE
  );


  // TÍTULO

  display.setTextSize(1);

  display.setCursor(
    20,
    0
  );

  display.println(
    "MONITORAMENTO SILO"
  );


  display.drawLine(
    0,
    10,
    127,
    10,
    SSD1306_WHITE
  );


  // NÍVEL

  display.setCursor(
    0,
    15
  );

  display.println(
    "NIVEL"
  );


  display.setTextSize(2);

  display.setCursor(
    0,
    26
  );


  if (!ultrassonicoOK) {

    display.println(
      "ERRO"
    );

  } else {

    display.print(
      (int)nivel
    );

    display.println(
      "%"
    );
  }


  // STATUS

  display.setTextSize(1);

  display.setCursor(
    55,
    17
  );

  display.println(
    obterStatus()
  );


  // BARRA

  display.drawRect(
    55,
    30,
    42,
    11,
    SSD1306_WHITE
  );


  if (ultrassonicoOK) {

    int largura =
      (int)(
        nivel * 38.0 / 100.0
      );


    if (largura > 38) {

      largura = 38;
    }


    if (largura > 0) {

      display.fillRect(
        57,
        32,
        largura,
        7,
        SSD1306_WHITE
      );
    }
  }


  display.drawLine(
    0,
    45,
    127,
    45,
    SSD1306_WHITE
  );


  // TEMPERATURA

  display.setCursor(
    0,
    51
  );

  display.print(
    "T:"
  );


  if (dhtOK) {

    display.print(
      temperatura,
      0
    );

    display.print(
      "C"
    );

  } else {

    display.print(
      "ERR"
    );
  }


  // UMIDADE

  display.setCursor(
    55,
    51
  );

  display.print(
    "U:"
  );


  if (dhtOK) {

    display.print(
      umidade,
      0
    );

    display.print(
      "%"
    );

  } else {

    display.print(
      "ERR"
    );
  }


  display.display();
}


