// =====================================================
// API DE DADOS
// =====================================================

void handleDados() {

  String json = "{";


  // NÍVEL

  json += "\"nivel\":";
  json += String(
    nivel,
    1
  );


  // TEMPERATURA

  json += ",";
  json += "\"temperatura\":";


  if (dhtOK) {

    json += String(
      temperatura,
      1
    );

  } else {

    json += "null";
  }


  // UMIDADE

  json += ",";
  json += "\"umidade\":";


  if (dhtOK) {

    json += String(
      umidade,
      1
    );

  } else {

    json += "null";
  }


  // DISTÂNCIA

  json += ",";
  json += "\"distancia\":";


  if (ultrassonicoOK) {

    json += String(
      distancia,
      2
    );

  } else {

    json += "null";
  }


  // STATUS

  json += ",";
  json += "\"status\":\"";

  json += obterStatus();

  json += "\"";


  // SENSOR ULTRASSÔNICO

  json += ",";
  json += "\"sensorUltrassonico\":";

  json +=
    ultrassonicoOK
    ? "true"
    : "false";


  // SENSOR DHT

  json += ",";
  json += "\"sensorDHT\":";

  json +=
    dhtOK
    ? "true"
    : "false";


  // UPTIME

  json += ",";
  json += "\"uptime\":\"";

  json += obterUptime();

  json += "\"";


  json += "}";


  server.send(
    200,
    "application/json",
    json
  );
}


